{
  "name": "detect-local-agents",
  "version": "0.2.3",
  "description": "Detect locally installed AI agents in TypeScript. Extensible architecture to easily support new agents.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "detect-local-agents": "./bin/cli.cjs",
    "dla": "./bin/cli.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cli": "node dist/cli/cli.js",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "keywords": [
    "ai",
    "agent",
    "detect",
    "local",
    "claude",
    "codex",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "^3.2.6",
    "detect-local-agents": "file:",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.16.0",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "yargs": "^18.1.0"
  }
}
